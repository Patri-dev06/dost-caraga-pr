[Unit]
Description=DOST Caraga Procurement Laravel API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=talinoserver2
Group=talinoserver2
WorkingDirectory=/home/talinoserver2/apps/dost-caraga-pr/current/pr_backend
Environment=APP_ENV=production
Environment=PHP_CLI_SERVER_WORKERS=8
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8000
Restart=always
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
